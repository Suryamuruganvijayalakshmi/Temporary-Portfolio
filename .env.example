# Surya V M Portfolio — Environment Configuration Template
# Canonical Domain: https://surya.signbridge.click

# Optional: Supabase Realtime Presence Configuration
# If unconfigured, the app falls back to local tab presence and offline broadcast simulator
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: GitHub API Access for Telemetry Heatmap
# If unconfigured, the app renders a verified contribution heatmap baseline
VITE_GITHUB_TOKEN=your_github_personal_access_token_here

# Optional: Contact Form Submission Dispatch (Formspree or Custom API)
# If unconfigured, the app provides honest fallback with prefilled direct mailto link
VITE_FORMSPREE_ID=your_formspree_form_id
VITE_CONTACT_API_URL=/api/contact

# Canonical Site URL
VITE_CANONICAL_URL=https://surya.signbridge.click
